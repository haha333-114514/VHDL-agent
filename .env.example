# Optional. Copy to .env for persistent local settings. Never share .env.
# Free preset. Get a free API key from https://openrouter.ai/keys
# Quotas and model availability are controlled by the provider.
MODEL_API_KEY=
MODEL_NAME=openrouter/free
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROTOCOL=chat_completions
# Also supports responses. Legacy OPENAI_* variables remain compatible;
# MODEL_* values take precedence. These variable names do not determine billing.
# Leave empty to discover GHDL through PATH or common Windows locations.
GHDL_PATH=
